* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:#f4f6f9
}

.contenu-principale {
    width: 100%;
    height: 100vh;
    margin: 0;
    padding: 0;
}
.page-content {
    position: absolute;
    top: 50px;
    left: 0;
    right: 0;
    bottom: 0;
    overflow-y: auto;
    overflow-x: hidden;

    -webkit-overflow-scrolling: touch;
}


/* Barre de titre */
.header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    padding: 10px 15px;
    display: flex;
    align-items: center;
    background: #3a10a1;
    color: white;
    z-index: 1000;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

/* Bouton menu */
.return-btn{
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.return-btn a{
	text-decoration: none;
	color: white;
}



.menu-btn i {
    font-size: 23px;
}

/* Titre */
.title-application {
    display: flex;
    padding: 0;
    margin-left: 12px;
    flex-direction: column;
    justify-content: center;
}

.title-application h3 {
    margin: 0;
    padding: 0;
    font-size: 18px;
    line-height: 20px;
    font-weight: bold;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
}

.title-application p {
    margin: 0;
    padding: 0;
    font-size: 12px;
    line-height: 13px;
    opacity: 0.85;
}

/* Notifications */
.title-gear {
    margin-left: auto;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.title-gear i {
    font-size: 23px;
}

.carte-profil{
	  display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px;
    margin: 15px;
    border-radius: 15px;
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.carte-profil img{
	  width: 110px;
    height: 110px;
    object-fit: cover;
    border-radius: 50%;
    flex-shrink: 0;
}

.identite{
	  flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.identite h3{
	  margin: 0 0 5px 0;
    font-size: 20px;
    font-weight: bold;;
}

.info-membre{
	  display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    line-height: 1.2;
}

.info-membre i{
	  margin: 0;
    padding: 0;
    color: #670ef7;
    font-size: 16px;
    width: 18px;
    text-align: center;
}

.info-membre p{
	margin: 0;
    padding: 0;
    font-size: 15px;
}

.actions-profil{
	  display: flex;
	  flex: 1;
    align-items: center;
    gap: 8px;
    margin-left: 5px;
    padding: 0;
    width: 100%;
}

.actions{
	display: flex;
	flex-direction: column;
	padding: 10px;
	width: 110px;
	gap: 8px;
	justify-content: center;
	align-items: center;
	border-radius: 12px;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	background: white;
}

.actions i{
	  margin: 0;
    padding: 0;
    color: #670ef7;
    font-size: 16px;
    width: 18px;
    text-align: center;
}

.actions p{
	padding: 0;
	margin: 0;
}

.histo{
	margin-left: 10px;
}