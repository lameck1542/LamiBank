<?xml version='1.0' encoding='utf-8'?>

<widget id="com.lamibank.app"
        version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>LamiBank</name>

    <description>
        Application de gestion bancaire hors ligne LamiBank.
    </description>

    <author email="dev@lamibank.app">
        LamiBank
    </author>

    <content src="index.html" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <platform name="android">

    <preference name="androidWindowSoftInputMode"
                value="adjustNothing" />

    <icon src="resources/logo.png" />

    <preference name="AndroidWindowSplashScreenAnimatedIcon"
                value="resources/splasher.png" />

    <preference name="AndroidWindowSplashScreenBackground"
                value="#3A10A1" />

    <preference name="SplashScreenDelay"
                value="2000" />

</platform>

</widget>
